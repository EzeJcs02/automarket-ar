# Supabase (ya los tenés)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...

# MercadoPago - Access Token de tu cuenta de MP
MP_ACCESS_TOKEN=APP_USR-...

# Supabase Service Role Key (para el webhook - bypassea RLS)
# La encontrás en Supabase → Settings → API → service_role key
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGci...

# Resend - para emails transaccionales (bienvenida, consultas)
# Obtené tu key en resend.com → API Keys
RESEND_API_KEY=re_...

# URL de producción (para back_urls del checkout)
APP_URL=https://automarket-ar.vercel.app

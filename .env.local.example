# Supabase — variables de build (Vite frontend)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...
VITE_ADMIN_EMAIL=tu@email.com        # Email admin expuesto al frontend (solo para ocultar la UI de admin)

# Supabase — variables de runtime (Serverless / API routes)
# Deben estar seteadas en Vercel → Settings → Environment Variables
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGci...        # misma que VITE_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci... # Settings → API → service_role key (NUNCA en el frontend)

# MercadoPago
MP_ACCESS_TOKEN=APP_USR-...
MP_WEBHOOK_SECRET=...                 # Webhook → Firma secreta en el panel de MP

# Resend — emails transaccionales
RESEND_API_KEY=re_...

# Admin
ADMIN_EMAIL=tu@email.com             # Email de la cuenta administradora del sistema
CRON_SECRET=...                      # Secreto para proteger los endpoints de cron
UNSUBSCRIBE_SECRET=...               # Secreto HMAC para tokens de baja de alertas (≥32 chars random)

# URL de producción (para back_urls del checkout)
APP_URL=https://automarket-ar.vercel.app
